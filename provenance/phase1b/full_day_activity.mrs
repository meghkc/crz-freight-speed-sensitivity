<?xml version='1.0' encoding='utf-8'?>
<runspec version="MOVES5.0.1">
  <description>Phase 1B full-day activity; same EPA inputs as Phase 1A; national default activity normalization, not measured local inventory.</description>
  <models>
    <model value="ONROAD" />
  </models>
  <modelscale value="Inventory" />
  <modeldomain value="SINGLE" />
  <geographicselections>
    <geographicselection type="COUNTY" key="36061" description="NEW YORK - New York County" />
  </geographicselections>
  <timespan>
    <year key="2025" />
    <month id="1" />
